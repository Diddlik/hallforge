<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:HallForge.App"
        x:Class="HallForge.App.ApplyDialog"
        x:DataType="app:ApplyRequest"
        Width="560" Height="480" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static app:Strings.ConfirmTitle}">
    <DockPanel Margin="24">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="16" Margin="0,16,0,0">
            <CheckBox x:Name="Consent" IsVisible="{Binding RequiresExperimentalConsent}" IsCheckedChanged="OnConsentChanged">
                <TextBlock Text="{x:Static app:Strings.ConfirmExperimental}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{x:Static app:Strings.Cancel}" Click="OnCancel" IsCancel="True" />
                <Button x:Name="ApplyButton" Content="{x:Static app:Strings.Apply}" Click="OnApply" Classes="accent" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" x:DataType="x:String" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
