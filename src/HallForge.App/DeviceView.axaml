<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:HallForge.App"
             x:Class="HallForge.App.DeviceView"
             x:DataType="app:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border.step">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource HfAccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.step > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource HfText2}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <!-- Discovering -->
            <Border Classes="panel" IsVisible="{Binding IsSearching}" Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static app:Strings.Searching}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- No keyboard: what the user can do -->
            <Border Classes="panel" IsVisible="{Binding IsNoDevice}" Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h1" Text="{x:Static app:Strings.NoKeyboardHeading}" />
                        <TextBlock Classes="secondary" Text="{x:Static app:Strings.NoKeyboardIntro}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Classes="step"><TextBlock Text="1" /></Border>
                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.NoKeyboardStep1}" TextWrapping="Wrap" />
                        <Border Grid.Row="1" Classes="step"><TextBlock Text="2" /></Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static app:Strings.NoKeyboardStep2}" TextWrapping="Wrap" />
                        <Border Grid.Row="2" Classes="step"><TextBlock Text="3" /></Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static app:Strings.NoKeyboardStep3}" TextWrapping="Wrap" />
                    </Grid>
                    <Border Classes="note" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </Border>
                    <Button Classes="accent" Content="{x:Static app:Strings.Retry}" Command="{Binding RefreshCommand}" Padding="18,6" />
                </StackPanel>
            </Border>

            <!-- Connected keyboard -->
            <StackPanel Spacing="16" IsVisible="{Binding HasKeyboard}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h1" Text="{x:Static app:Strings.NavDevice}" />
                    <TextBlock Classes="secondary" Text="{x:Static app:Strings.DeviceIntro}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="panel" DataContext="{Binding Keyboard}">
                    <Grid x:DataType="app:KeyboardEditorViewModel" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
                        <TextBlock Classes="label" Text="{x:Static app:Strings.DeviceModel}" />
                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Classes="label" Text="{x:Static app:Strings.DeviceUsbId}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsbId}" />
                        <TextBlock Grid.Row="2" Classes="label" Text="{x:Static app:Strings.DeviceModelIds}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModelIds}" />
                        <TextBlock Grid.Row="3" Classes="label" Text="{x:Static app:Strings.DeviceProfile}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileText}" />
                        <TextBlock Grid.Row="4" Classes="label" Text="{x:Static app:Strings.DeviceSupport}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Static app:Strings.Experimental}" Classes="warn" FontWeight="SemiBold" IsVisible="{Binding IsExperimental}" />
                            <TextBlock Text="{x:Static app:Strings.ExperimentalHelp}" Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Classes="label" Text="{x:Static app:Strings.DeviceLayout}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LayoutSummary}" />
                    </Grid>
                </Border>

                <!-- Keyboard-wide settings, written right away and read back -->
                <Border Classes="panel" DataContext="{Binding Keyboard.Settings}">
                    <StackPanel x:DataType="app:KeyboardSettingsViewModel" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="h2" Text="{x:Static app:Strings.KeyboardSettings}" />
                            <TextBlock Classes="secondary" Text="{x:Static app:Strings.KeyboardSettingsIntro}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="10">
                            <TextBlock Classes="label" Text="{x:Static app:Strings.TravelMode}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllModes}" SelectedItem="{Binding Mode}" MinWidth="320"
                                      IsEnabled="{Binding IsLoaded}" AutomationProperties.Name="{x:Static app:Strings.TravelMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="app:TravelModeItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Classes="label" Text="{x:Static app:Strings.DeviceProfile}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllProfiles}" SelectedItem="{Binding Profile}" MinWidth="320"
                                      IsEnabled="{Binding IsLoaded}" AutomationProperties.Name="{x:Static app:Strings.DeviceProfile}"
                                      ToolTip.Tip="{x:Static app:Strings.OnboardProfileHelp}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="app:OnboardProfileItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                            <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Classes="caption warn" Text="{x:Static app:Strings.KeyboardSettingsExperimental}" TextWrapping="Wrap"
                                   IsVisible="{Binding RequiresExperimentalConsent}" />
                    </StackPanel>
                </Border>

                <!-- Opt-in switching of travel mode and onboard profile per foreground program -->
                <Border Classes="panel" DataContext="{Binding AutoSwitch}">
                    <StackPanel x:DataType="app:AutoSwitchViewModel" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h2" Text="{x:Static app:Strings.AutoSwitchTitle}" />
                                <TextBlock Classes="secondary" Text="{x:Static app:Strings.AutoSwitchIntro}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top"
                                          IsEnabled="{x:Static app:AutoSwitchViewModel.IsSupported}"
                                          OnContent="{x:Static app:Strings.AutoSwitchEnable}" OffContent="{x:Static app:Strings.AutoSwitchEnable}" />
                        </Grid>
                        <TextBlock Classes="caption warn" Text="{x:Static app:Strings.AutoSwitchUnsupported}"
                                   IsVisible="{x:Static app:AutoSwitchViewModel.IsUnsupported}" />

                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="app:ProgramRuleViewModel">
                                    <Grid ColumnDefinitions="160,*,140,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Program}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedItem="{Binding Mode}"
                                                  ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllModes}" AutomationProperties.Name="{x:Static app:Strings.TravelMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="app:TravelModeItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" SelectedItem="{Binding Profile}"
                                                  ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllProfiles}" AutomationProperties.Name="{x:Static app:Strings.DeviceProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="app:OnboardProfileItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="3" Classes="step" Content="✕" AutomationProperties.Name="{Binding RemoveName}" ToolTip.Tip="{Binding RemoveName}"
                                                Command="{Binding $parent[ItemsControl].((app:AutoSwitchViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="160,*,140,Auto" ColumnSpacing="8">
                            <TextBlock Text="{x:Static app:Strings.AutoSwitchOther}" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllModes}" SelectedItem="{Binding OtherMode}"
                                      AutomationProperties.Name="{x:Static app:Strings.AutoSwitchOther}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="app:TravelModeItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Static app:KeyboardSettingsViewModel.AllProfiles}" SelectedItem="{Binding OtherProfile}"
                                      AutomationProperties.Name="{x:Static app:Strings.AutoSwitchOther}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="app:OnboardProfileItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <AutoCompleteBox Text="{Binding NewProgram}" ItemsSource="{Binding RunningPrograms}" FilterMode="ContainsOrdinal"
                                             PlaceholderText="{x:Static app:Strings.AutoSwitchProgramHint}" AutomationProperties.Name="{x:Static app:Strings.AutoSwitchProgramHint}"
                                             GotFocus="OnProgramBoxFocused" />
                            <Button Grid.Column="1" Classes="outline" Content="{x:Static app:Strings.AutoSwitchAdd}" Command="{Binding AddCommand}" />
                            <Button Grid.Column="2" Classes="step" Command="{Binding RefreshProgramsCommand}"
                                    AutomationProperties.Name="{x:Static app:Strings.AutoSwitchRefresh}" ToolTip.Tip="{x:Static app:Strings.AutoSwitchRefresh}">
                                <Path Classes="icon small" Data="{StaticResource IconRefresh}" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="caption" Text="{x:Static app:Strings.AutoSwitchNote}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="panel" DataContext="{Binding Keyboard}">
                    <StackPanel x:DataType="app:KeyboardEditorViewModel" Spacing="12">
                        <TextBlock Classes="h2" Text="{x:Static app:Strings.Backup}" />
                        <TextBlock Text="{x:Static app:Strings.BackupAvailable}" TextWrapping="Wrap" IsVisible="{Binding !NeedsBackup}" />
                        <StackPanel Spacing="12" IsVisible="{Binding NeedsBackup}">
                            <TextBlock Text="{x:Static app:Strings.NoBackupYet}" TextWrapping="Wrap" />
                            <Button Classes="accent" Content="{x:Static app:Strings.ImportBackup}" Command="{Binding ImportBackupCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Classes="secondary" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
