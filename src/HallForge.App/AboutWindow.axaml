<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:HallForge.App"
        x:Class="HallForge.App.AboutWindow"
        x:DataType="app:MainViewModel"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static app:Strings.AboutTitle}">
    <StackPanel Margin="24" Spacing="8">
        <TextBlock Text="HallForge" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static app:MainViewModel.Version}" />
        <TextBlock Text="{x:Static app:Strings.Copyright}" />
        <TextBlock Text="{x:Static app:Strings.LicenseText}" TextWrapping="Wrap" />

        <TextBlock Text="{x:Static app:Strings.ThirdParty}" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ItemsControl ItemsSource="{x:Static app:MainViewModel.ThirdPartyLibraries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:ThirdPartyLibrary">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding License}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox Content="{x:Static app:Strings.AutoCheckUpdates}" IsChecked="{Binding AutoCheckForUpdates}" Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static app:Strings.CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" />

        <Button Content="{x:Static app:Strings.Close}" Click="OnClose" HorizontalAlignment="Right" Classes="accent" IsDefault="True" IsCancel="True" Margin="0,16,0,0" />
    </StackPanel>
</Window>
