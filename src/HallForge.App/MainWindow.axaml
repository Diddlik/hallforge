<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:HallForge.App"
        x:Class="HallForge.App.MainWindow"
        x:DataType="app:MainViewModel"
        Width="1100" Height="720" MinWidth="720" MinHeight="520"
        Title="{x:Static app:MainViewModel.Title}">
    <Window.Styles>
        <Style Selector="ToggleButton.key">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ToggleButton.key.pending">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <!-- Header: device and secondary actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Keyboard.DeviceName, FallbackValue={x:Static app:Strings.KeyboardsHeading}}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static app:Strings.ExperimentalBadge}" Classes="secondary" TextWrapping="Wrap"
                           IsVisible="{Binding Keyboard.IsExperimental, FallbackValue=False}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static app:Strings.LoadProfile}" Click="OnLoadProfile" IsEnabled="{Binding Keyboard, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Grid.Column="2" Content="{x:Static app:Strings.Refresh}" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="3" Content="{x:Static app:Strings.About}" Click="OnAbout" />
        </Grid>

        <!-- Update notice -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsUpdateReady}" Padding="12" Margin="0,0,0,8" CornerRadius="4"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="{x:Static app:Strings.UpdateInstall}" Command="{Binding InstallUpdateCommand}" />
                <Button Grid.Column="2" Content="{x:Static app:Strings.UpdateLater}" Command="{Binding PostponeUpdateCommand}" />
            </Grid>
        </Border>

        <!-- Empty or error state when no keyboard is shown -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"
                   IsVisible="{Binding Keyboard, Converter={x:Static ObjectConverters.IsNull}}" />

        <ContentControl Content="{Binding Keyboard}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="app:KeyboardEditorViewModel">
                    <TabControl>
                    <TabItem Header="{x:Static app:Strings.TabKeys}">
                    <DockPanel>
                        <!-- Footer: status and the single primary action -->
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static app:Strings.ImportBackup}" Command="{Binding ImportBackupCommand}" IsVisible="{Binding NeedsBackup}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Static app:Strings.Discard}" Command="{Binding DiscardCommand}" />
                                <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Classes="accent" />
                            </StackPanel>
                        </Grid>

                        <!-- Editor for the selected keys -->
                        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Content="{x:Static app:Strings.PresetWasd}" Command="{Binding SelectCommand}" CommandParameter="WASD" />
                                <Button Content="{x:Static app:Strings.PresetMovement}" Command="{Binding SelectCommand}" CommandParameter="Movement" />
                                <Button Content="{x:Static app:Strings.PresetActions}" Command="{Binding SelectCommand}" CommandParameter="Actions" />
                                <Button Content="{x:Static app:Strings.PresetNumbers}" Command="{Binding SelectCommand}" CommandParameter="Numbers" />
                                <Button Content="{x:Static app:Strings.PresetAll}" Command="{Binding SelectCommand}" CommandParameter="All" />
                                <Button Content="{x:Static app:Strings.PresetNone}" Command="{Binding SelectCommand}" CommandParameter="None" />
                            </WrapPanel>
                            <TextBlock Text="{x:Static app:Strings.SelectKeysHint}" Classes="secondary" IsVisible="{Binding !HasSelection}" />
                            <WrapPanel ItemSpacing="16" LineSpacing="8" IsEnabled="{Binding HasSelection}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.Actuation}" />
                                    <NumericUpDown Value="{Binding Actuation}" Minimum="{Binding Limits.Travel.MinMm}" Maximum="{Binding Limits.Travel.MaxMm}"
                                                   Increment="{Binding Limits.Travel.StepMm}" FormatString="0.0" Width="140"
                                                   PlaceholderText="{x:Static app:Strings.Mixed}" AutomationProperties.Name="{x:Static app:Strings.Actuation}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.Release}" />
                                    <NumericUpDown Value="{Binding Release}" Minimum="{Binding Limits.Travel.MinMm}" Maximum="{Binding Limits.Travel.MaxMm}"
                                                   Increment="{Binding Limits.Travel.StepMm}" FormatString="0.0" Width="140"
                                                   PlaceholderText="{x:Static app:Strings.Mixed}" AutomationProperties.Name="{x:Static app:Strings.Release}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.RapidTrigger}" />
                                    <CheckBox IsChecked="{Binding RapidTrigger}" IsThreeState="False" Margin="0,4,0,0"
                                              AutomationProperties.Name="{x:Static app:Strings.RapidTrigger}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.RapidTriggerPress}" />
                                    <NumericUpDown Value="{Binding RapidTriggerPress}" Minimum="{Binding Limits.RapidTrigger.MinMm}" Maximum="{Binding Limits.RapidTrigger.MaxMm}"
                                                   Increment="{Binding Limits.RapidTrigger.StepMm}" FormatString="0.0" Width="140"
                                                   PlaceholderText="{x:Static app:Strings.Mixed}" AutomationProperties.Name="{x:Static app:Strings.RapidTriggerPress}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.RapidTriggerRelease}" />
                                    <NumericUpDown Value="{Binding RapidTriggerRelease}" Minimum="{Binding Limits.RapidTrigger.MinMm}" Maximum="{Binding Limits.RapidTrigger.MaxMm}"
                                                   Increment="{Binding Limits.RapidTrigger.StepMm}" FormatString="0.0" Width="140"
                                                   PlaceholderText="{x:Static app:Strings.Mixed}" AutomationProperties.Name="{x:Static app:Strings.RapidTriggerRelease}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.Deadzone}" />
                                    <NumericUpDown Value="{Binding Deadzone}" Minimum="{Binding Limits.Deadzone.MinMm}" Maximum="{Binding Limits.Deadzone.MaxMm}"
                                                   Increment="{Binding Limits.Deadzone.StepMm}" FormatString="0.0" Width="140"
                                                   PlaceholderText="{x:Static app:Strings.Mixed}" AutomationProperties.Name="{x:Static app:Strings.Deadzone}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Keyboard: real key geometry, scaled to the available space -->
                        <Viewbox Stretch="Uniform" StretchDirection="Both">
                            <ItemsControl ItemsSource="{Binding Keys}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                          AutomationProperties.Name="{x:Static app:Strings.KeyboardViewName}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter" x:DataType="app:KeyViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="app:KeyViewModel">
                                        <ToggleButton Classes="key" Classes.pending="{Binding IsPending}"
                                                      Width="{Binding Width}" Height="{Binding Height}"
                                                      IsChecked="{Binding IsSelected}"
                                                      AutomationProperties.Name="{Binding AccessibleName}"
                                                      ToolTip.Tip="{Binding AccessibleName}">
                                            <Grid RowDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Legend}" FontSize="12" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                    <TextBlock Text="RT" FontSize="9" FontWeight="Bold" IsVisible="{Binding IsRapidTrigger}" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{Binding ValueText}" FontSize="10" Classes="secondary" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </DockPanel>
                    </TabItem>
                    <TabItem Header="{x:Static app:Strings.TabLighting}" DataContext="{Binding Lighting}">
                        <DockPanel x:DataType="app:LightingViewModel" Margin="0,16,0,0">
                            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{x:Static app:Strings.ApplyLighting}" Command="{Binding ApplyCommand}" Classes="accent" />
                            </Grid>
                            <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Left" IsEnabled="{Binding IsLoaded}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.LightingEffect}" />
                                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="240"
                                              AutomationProperties.Name="{x:Static app:Strings.LightingEffect}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="app:LightingModeItem">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.LightingBrightness}" />
                                    <Slider Value="{Binding Brightness}" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                            AutomationProperties.Name="{x:Static app:Strings.LightingBrightness}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static app:Strings.LightingSpeed}" />
                                    <Slider Value="{Binding Speed}" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                            AutomationProperties.Name="{x:Static app:Strings.LightingSpeed}" />
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding HasVariants}">
                                    <TextBlock Text="{x:Static app:Strings.LightingVariant}" />
                                    <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding Variant}" MinWidth="240"
                                              AutomationProperties.Name="{x:Static app:Strings.LightingVariant}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="app:LightingVariantItem">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Content="{x:Static app:Strings.LightingRainbow}" IsChecked="{Binding Rainbow}" />
                                <StackPanel Spacing="4" IsEnabled="{Binding !Rainbow}">
                                    <TextBlock Text="{x:Static app:Strings.LightingColor}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Text="{Binding ColorHex}" Width="140" MaxLength="6"
                                                 AutomationProperties.Name="{x:Static app:Strings.LightingColor}" />
                                        <Border Width="32" Height="32" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                Background="{Binding ColorPreview, FallbackValue=Transparent}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </TabItem>
                    </TabControl>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>
