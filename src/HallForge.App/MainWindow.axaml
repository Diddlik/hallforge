<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HallForge.App.MainWindow"
        Width="800" Height="480" MinWidth="480" MinHeight="320"
        Title="HallForge">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Keyboards" FontSize="20" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh" Classes="accent" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />
        <ListBox x:Name="DeviceList" AutomationProperties.Name="Detected keyboards" />
    </DockPanel>
</Window>
